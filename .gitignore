# Copyrighted game data — never commit (full game install lives here)
game/
vanilla/
jp/
ne/
jp_ne/
Rance7.ain
*.ain
System40.ini
SaveData/
backup/

# Generated dumps and build output
dump/
build/
dist/
*.jam
!hooks.jam
*.tmp

# Tool binaries — downloaded at setup time (see AGENTS.md), do not commit
tools/*.exe
# Local throwaway scripts / patch variants kept in tools/
tools/_*.py
tools/*.bak_*
tools/ain_adv_patch_[A-Z].py

# Local working area (test installs, dumps, generated AINs — may contain
# copyrighted game data)
work/

# Extracted/derived game dialogue (copyrighted) — local working copies only
src/*_prologue_*.txt
src/dlc1_op_script.txt

# Installer payload - derived game assets and bundled binaries (copyrighted / GPL binary)
installer/bin/
# Embedded python runtime + pip packages - provisioned by ci/provision_runtime.ps1
installer/runtime/
# Python caches
__pycache__/
*.pyc
# Local release build output
release/
